import { adminClient, publicClient } from "../_shared/supabase.ts";
import { isAllowedOrigin, json, options } from "../_shared/http.ts";

type Delivery = {
  delivery_id: string;
  target_request_id: string;
  recipient_email: string;
  student_name: string;
  request_protocol: string;
  request_type_name: string;
  delivery_attempt_count: number;
};

const uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
const resendKeyPattern = /^re_[A-Za-z0-9_]{20,}$/;
const requiredSender = "Requerimentos IPE <nao-responder@estudeipe.com.br>";

function secureEqual(left: string, right: string) {
  if (!left || !right || left.length !== right.length) return false;
  let difference = 0;
  for (let index = 0; index < left.length; index += 1) {
    difference |= left.charCodeAt(index) ^ right.charCodeAt(index);
  }
  return difference === 0;
}

function escapeHtml(value: string) {
  return value
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;")
    .replaceAll("'", "&#039;");
}

function message(delivery: Delivery) {
  const studentName = escapeHtml(delivery.student_name);
  const protocol = escapeHtml(delivery.request_protocol);
  const requestType = escapeHtml(delivery.request_type_name);
  return {
    subject: `Requerimento ${delivery.request_protocol} concluído`,
    text: [
      `Olá, ${delivery.student_name}.`,
      "",
      `Seu requerimento ${delivery.request_protocol} — ${delivery.request_type_name} foi concluído e está disponível para retirada na escola.`,
      "",
      "Esta é uma mensagem automática. Não responda a este e-mail.",
    ].join("\n"),
    html: `<p>Olá, ${studentName}.</p><p>Seu requerimento <strong>${protocol}</strong> — ${requestType} foi concluído e está disponível para retirada na escola.</p><p>Esta é uma mensagem automática. Não responda a este e-mail.</p>`,
  };
}

async function authorizedUser(
  request: Request,
  requestId: string,
  admin: ReturnType<typeof adminClient>,
) {
  const authorization = request.headers.get("authorization") || "";
  if (!authorization.startsWith("Bearer ")) return false;
  const client = publicClient(authorization);
  const { data: authData, error: authError } = await client.auth.getUser();
  if (authError || !authData.user) return false;

  const { data: target, error: targetError } = await admin
    .from("requests")
    .select("organization_id,status")
    .eq("id", requestId)
    .maybeSingle();
  if (targetError || !target || target.status !== "completed") return false;

  const [profileResult, membershipResult, completionResult] = await Promise.all([
    admin
      .from("profiles")
      .select("is_active")
      .eq("id", authData.user.id)
      .maybeSingle(),
    admin
      .from("memberships")
      .select("role")
      .eq("organization_id", target.organization_id)
      .eq("user_id", authData.user.id)
      .maybeSingle(),
    admin
      .from("request_events")
      .select("id")
      .eq("request_id", requestId)
      .eq("actor_id", authData.user.id)
      .eq("to_status", "completed")
      .limit(1)
      .maybeSingle(),
  ]);

  if (
    profileResult.error ||
    membershipResult.error ||
    completionResult.error ||
    !profileResult.data?.is_active ||
    !membershipResult.data
  ) {
    return false;
  }

  return membershipResult.data.role === "admin" ||
    (
      ["coordinator", "attendant"].includes(membershipResult.data.role) &&
      Boolean(completionResult.data)
    );
}

Deno.serve(async (request) => {
  if (request.method === "OPTIONS") return options(request);
  if (request.method !== "POST") return json(request, { error: "Method not allowed." }, 405);
  if (!isAllowedOrigin(request)) return json(request, { error: "Origin not allowed." }, 403);

  const resendApiKey = Deno.env.get("RESEND_API_KEY") || "";
  const emailFrom = Deno.env.get("REQUEST_EMAIL_FROM") || "";
  const dispatchSecret = Deno.env.get("EMAIL_DISPATCH_SECRET") || "";
  if (
    !resendKeyPattern.test(resendApiKey) ||
    dispatchSecret.length < 32 ||
    emailFrom !== requiredSender
  ) {
    return json(request, { error: "O serviço de e-mail ainda não está configurado." }, 503);
  }

  const body = await request.json().catch(() => ({}));
  const requestId = typeof body.requestId === "string" ? body.requestId : "";
  if (requestId && !uuidPattern.test(requestId)) {
    return json(request, { error: "Requerimento inválido." }, 400);
  }

  const scheduled = secureEqual(
    request.headers.get("x-email-dispatch-secret") || "",
    dispatchSecret,
  );
  const admin = adminClient();
  if (
    !scheduled &&
    (!requestId || !(await authorizedUser(request, requestId, admin)))
  ) {
    return json(request, { error: "Não autorizado." }, 403);
  }

  const { data, error } = await admin.rpc("claim_request_email_deliveries", {
    p_limit: scheduled ? 10 : 1,
    p_request_id: requestId || null,
  });
  if (error) return json(request, { error: "Não foi possível processar a fila." }, 500);

  const deliveries = (data || []) as Delivery[];
  let sent = 0;
  let failed = 0;

  for (const delivery of deliveries) {
    const content = message(delivery);
    let providerMessageId = "";
    let errorCode = "resend_network_error";

    try {
      const response = await fetch("https://api.resend.com/emails", {
        method: "POST",
        headers: {
          Authorization: `Bearer ${resendApiKey}`,
          "Content-Type": "application/json",
          "Idempotency-Key": `request-completed-${delivery.target_request_id}`,
          "User-Agent": "requerimentos-ipe/1.0",
        },
        body: JSON.stringify({
          from: emailFrom,
          to: [delivery.recipient_email],
          subject: content.subject,
          text: content.text,
          html: content.html,
        }),
      });

      if (response.ok) {
        const result = await response.json().catch(() => ({}));
        providerMessageId = typeof result.id === "string" ? result.id : "accepted";
      } else {
        errorCode = `resend_http_${response.status}`;
      }
    } catch {
      errorCode = "resend_network_error";
    }

    if (providerMessageId) {
      const marked = await admin.rpc("mark_request_email_delivery_sent", {
        p_delivery_id: delivery.delivery_id,
        p_provider_message_id: providerMessageId,
      });
      if (!marked.error && marked.data === true) sent += 1;
      else failed += 1;
    } else {
      await admin.rpc("mark_request_email_delivery_failed", {
        p_delivery_id: delivery.delivery_id,
        p_error_code: errorCode,
      });
      failed += 1;
    }
  }

  return json(request, {
    processed: deliveries.length,
    sent,
    failed,
  });
});
